{
  "name": "shadcn-firebase-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.1 || ^24.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "setup:github": "node scripts/setup-github.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.build.json",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs -- src",
    "check:unused": "knip",
    "check:duplicates": "jscpd --config .jscpd.json",
    "check:structure": "ast-grep test && ast-grep scan",
    "check:docs": "node --test scripts/checks/check-docs.test.mjs && node scripts/checks/check-docs.mjs",
    "check:adr": "node --test scripts/checks/check-adr.test.mjs && node scripts/checks/check-adr.mjs",
    "check:spelling": "cspell lint \"**/*.{ts,tsx,md,json}\" --no-progress",
    "check:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.next\"",
    "check:security": "semgrep scan --config .semgrep/rules.yml --error --metrics=off --disable-version-check src next.config.ts",
    "check:security:rules": "semgrep --test .semgrep",
    "check:secrets": "gitleaks git --no-banner --redact",
    "check:workflows": "actionlint && zizmor .github/workflows",
    "audit": "pnpm audit",
    "audit:functions": "npm --prefix functions audit --package-lock-only --ignore-scripts",
    "verify:fast": "pnpm lint:ci && pnpm typecheck && pnpm test && pnpm test:logging && pnpm test:evals && pnpm test:production-smoke && pnpm check:structure && pnpm check:routes && pnpm check:components && pnpm check:responsiveness && pnpm check:english && pnpm check:docs && pnpm check:adr",
    "verify:static": "pnpm lint:ci && pnpm typecheck && pnpm test:coverage && pnpm test:logging && pnpm test:production-smoke && pnpm check:architecture && pnpm check:unused && pnpm check:duplicates && pnpm check:structure && pnpm check:routes && pnpm check:components && pnpm check:responsiveness && pnpm check:english && pnpm check:docs && pnpm check:adr && pnpm check:spelling && pnpm check:markdown && pnpm analyze:fallow && pnpm analyze:react",
    "verify:build": "pnpm test:browser && pnpm analyze:size && pnpm ladle:build",
    "verify:full": "pnpm verify:static && pnpm verify:build",
    "verify:security": "pnpm check:security:rules && pnpm check:security && pnpm check:secrets && pnpm check:workflows && pnpm audit && pnpm audit:functions",
    "verify:e2e": "playwright test",
    "test": "vitest run --project unit",
    "test:logging": "node --test functions/usage-logs.test.cjs functions/user-roles.test.cjs",
    "test:evals": "node --test scripts/evals/run-tool-usage-evals.test.mjs",
    "test:production-smoke": "node --test scripts/checks/check-production-smoke.test.mjs",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test --grep-invert \"@a11y|@visual\"",
    "test:auth": "firebase emulators:exec --only auth,firestore,functions \"playwright test --project=auth-emulator\"",
    "emulator": "firebase emulators:start --only auth,firestore,database,storage,hosting,pubsub,functions,extensions --import=./emulator-data --export-on-exit",
    "emulator:export": "firebase emulators:export ./emulator-data --force",
    "emulator:clear": "node scripts/emulator/clear.mjs",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:mutation": "stryker run",
    "analyze:react": "react-doctor --no-score --no-telemetry --no-supply-chain",
    "analyze:bundle": "next experimental-analyze",
    "analyze:size": "next build && size-limit",
    "analyze:lighthouse": "node -e \"require('node:fs').mkdirSync('reports/lighthouse',{recursive:true})\" && lighthouse http://127.0.0.1:3000 --output=html --output-path=reports/lighthouse/report.html --chrome-flags=\"--headless\"",
    "analyze:lighthouse:ci": "node -e \"require('node:fs').mkdirSync('reports/lighthouse',{recursive:true})\" && lighthouse http://127.0.0.1:3000 --output=html --output-path=reports/lighthouse/report.html --chrome-flags=\"--headless --no-sandbox\"",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "prepare": "husky",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "analyze:fallow": "fallow health --coverage coverage/coverage-final.json --min-score 75",
    "analyze:health": "pnpm test:coverage && pnpm analyze:fallow",
    "check:routes": "node --test scripts/checks/check-route-files.test.mjs && node scripts/checks/check-route-files.mjs",
    "check:components": "node --test scripts/checks/check-component-conventions.test.mjs scripts/checks/check-component-composition.test.mjs && node scripts/checks/check-component-conventions.mjs",
    "check:english": "node --test scripts/checks/check-english.test.mjs && node scripts/checks/check-english.mjs",
    "check:responsiveness": "node --test scripts/checks/check-responsiveness.test.mjs && node scripts/checks/check-responsiveness.mjs",
    "eval:tool-usage": "node scripts/evals/run-tool-usage-evals.mjs",
    "doctor": "react-doctor --no-score --no-telemetry --no-supply-chain"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched",
    "*.{md,mdx,mjs,cjs,yml,yaml}": "node scripts/checks/check-english.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@firebase-oss/ui-core": "^7.1.0",
    "@firebase-oss/ui-react": "^7.1.0",
    "@firebase-oss/ui-translations": "7.1.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@rive-app/react-webgl2": "^4.37.1",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.153",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "media-chrome": "^4.19.4",
    "motion": "^14.5.0",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.10.1",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.1",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@cspell/dict-pt-br": "2.4.4",
    "@ladle/react": "5.1.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "14.2.0",
    "@stryker-mutator/core": "10.0.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "10.4.0",
    "dependency-cruiser": "18.7.0",
    "fallow": "^3.34.1",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "jsdom": "^30.1.3",
    "knip": "6.42.1",
    "lighthouse": "13.5.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "next-devtools-mcp": "0.4.0",
    "react-doctor": "^0.9.18",
    "size-limit": "14.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "packageManager": "pnpm@12.14.0"
}
