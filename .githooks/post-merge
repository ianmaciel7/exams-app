#!/bin/sh
# 1. Auto-sync cross-agent configurations (AGENTS.md, MCP, skills)
if which agents >/dev/null 2>&1; then
    agents sync || true
fi

# 2. Auto-sync Claude live artifact whenever prototypes/exam-app-0.1.1/index.html changes after a merge/pull
if git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD | grep -q "prototypes/exam-app-0.1.1/index.html"; then
    echo "=========================================================="
    echo " [Sync] prototypes/exam-app-0.1.1/index.html merged/pulled."
    echo " Syncing Claude live artifact..."
    echo "=========================================================="
    uvx --from claude-artifact-cli claude-artifact publish --mode patch --url https://claude.ai/artifact/MeCzKuKCsr6fY4F8AGxnyC prototypes/exam-app-0.1.1/index.html || true
fi

# 3. Mirror dev to Claude tracking branch if on dev
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" = "dev" ]; then
    git push origin dev:claude/project-thread-6zihkn --quiet || true
fi
