# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/reports/
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/manifest.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Generated documentation artifacts
/docs/artifacs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
database-debug.log*
pubsub-debug.log*
gha-creds-*.json

# env files (can opt-in for committing if needed)
.env*
!.env.example

.firebase/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agents & local tool state
.serena/
.agents/local.json
.agents/generated/
.agents/agents.json.*.bak
.agents/plugin-data/
.agents/mcp_config.json
.claude/
CLAUDE.md
.codex/
.gemini/
.mcp.json
.vscode/mcp.json
.cursor/
.antigravity/
.windsurf/
.opencode/
opencode.json
.junie/mcp/
.grok/config.toml
.factory/mcp.json
.devin/mcp_config.json
.claude/skills
.junie/skills
.kilo/skills

# local analysis state
.fallow/

# mutation testing
/.stryker-tmp/

# worktrees
.worktrees/

# Terraform: state, plans and variable files hold billing, organization and resource data.
# Only *.tfvars.example may be committed.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/tfplan
**/*.tfvars
**/*.tfvars.json
!**/*.tfvars.example
**/backend.hcl
**/override.tf
**/override.tf.json
**/*_override.tf
**/crash.log
**/crash.*.log
**/.terraform.tfstate.lock.info

# Service account keys and credential files
*-credentials.json
*service-account*.json
application_default_credentials.json
