{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // src/components is the template's public component library, so every file
  // there is an entry point. Application code (hooks, lib, i18n) is NOT listed
  // here: it is only reachable through routes, components, stories or tests, so
  // genuinely unused application code is still reported.
  "entry": [
    "src/app/{page,layout,loading,error,not-found,route}.{ts,tsx}",
    "src/components/**/*.{ts,tsx}",
    "src/**/*.stories.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  // Installed by the shadcn code-block registry item; keep them so registry
  // updates stay clean even though nothing imports them yet.
  "ignore": ["src/lib/highlighter.tsx", "src/hooks/use-highlighted-code.ts"],
  "ignoreIssues": {
    "src/i18n/routing.ts": ["exports"],
    // ADR 0004 specifies these path-based navigation helpers as part of the
    // accepted i18n design, even though no route uses every export yet.
    "src/i18n/navigation.ts": ["exports"],
    // Firebase shadcn registry imports assume their upstream flat layout.
    "src/components/firebase/**": ["unresolved"]
  },
  "ignoreDependencies": [
    // Referenced only from CSS, which Knip does not follow.
    "shadcn",
    "tailwindcss",
    "tw-animate-css",
    // Launched by .agents/agents.json as an MCP server.
    "next-devtools-mcp",
    // Built into @stryker-mutator/core; Knip reads the runner name as a package.
    "@stryker-mutator/command-runner"
  ],
  // Host tools installed outside pnpm (see TOOLING.md).
  "ignoreBinaries": [
    "semgrep",
    "gitleaks",
    "actionlint",
    "zizmor",
    "firebase",
    "terraform",
    "taskkill.exe"
  ]
}
