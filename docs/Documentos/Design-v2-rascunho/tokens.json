{
  "name": "Exams App Design System",
  "version": "2.0.0",
  "color": {
    "light": {
      "bg": "#faf9f5", "surface": "#ffffff", "text": "#141413", "muted": "#5e5d59",
      "border": "#e8e6dc", "border-strong": "#8a8878",
      "accent": "#b4492a", "on-accent": "#ffffff",
      "correct": "#3f6b2a", "incorrect": "#b3261e", "marked": "#2f6a9a", "warning": "#8a5a00"
    },
    "dark": {
      "bg": "#1f1e1d", "surface": "#2b2a28", "text": "#faf9f5", "muted": "#b0aea5",
      "border": "#3d3b37", "border-strong": "#7d7b72",
      "accent": "#e8896a", "on-accent": "#1f1e1d",
      "correct": "#8fbf6f", "incorrect": "#f08a80", "marked": "#7db4e0", "warning": "#e0b25c"
    }
  },
  "typography": {
    "font-display": "'Source Serif 4', Georgia, serif",
    "font-ui": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "font-mono": "'JetBrains Mono', ui-monospace, monospace",
    "scale-px": { "xs": 12, "sm": 14, "base": 16, "lg": 18, "xl": 22, "2xl": 28, "3xl": 36 },
    "line-height": { "ui": 1.4, "reading": 1.6 },
    "reading-measure-ch": 68
  },
  "space-px": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius-px": { "sm": 6, "md": 8, "lg": 12, "pill": 999 },
  "shadow": {
    "light": { "sm": "0 1px 2px rgba(20,20,19,.06)", "md": "0 4px 16px rgba(20,20,19,.08)" },
    "dark": { "sm": "0 1px 2px rgba(0,0,0,.4)", "md": "0 4px 16px rgba(0,0,0,.5)" }
  },
  "a11y": { "min-touch-target-px": 44, "focus-ring": "2px solid accent, offset 2px", "contrast": "WCAG 2.2 AA" }
}
