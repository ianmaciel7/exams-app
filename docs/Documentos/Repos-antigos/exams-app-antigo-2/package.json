{
  "name": "exams-app-prototypes",
  "private": true,
  "scripts": {
    "start": "python scripts/dev-stack.py",
    "start:open": "python scripts/dev-stack.py --open",
    "dev": "python -m http.server 8765 --directory prototype",
    "board": "python prototype/board_to_md.py",
    "test:motion": "node --test tests/motion-graph.test.mjs",
    "proxy": "python services/proxy/claude_storage_proxy.py",
    "sync:artifact": "python scripts/claude-sync-gate.py",
    "agents:sync": "agents sync",
    "agents:status": "agents status",
    "sync:all": "npm run agents:sync && npm run sync:artifact",
    "setup:hooks": "git config core.hooksPath .githooks"
  }
}
