{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firebase: Start Emulators",
      "type": "shell",
      "command": "pnpm emulator",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting emulators...",
          "endsPattern": "All emulators ready!"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Firebase: Clear Emulator Data",
      "type": "shell",
      "command": "pnpm emulator:clear",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Firebase: Export Emulator Data",
      "type": "shell",
      "command": "pnpm emulator:export",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
