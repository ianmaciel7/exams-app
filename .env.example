# Firebase Web SDK Configuration
# For production: obtain credentials from Firebase Console (Project settings > General > Your apps)
# For local emulator: use a local project ID and local emulator host
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_GOOGLE_ENABLED=false

# Firebase Local Emulator Suite (Official Firebase environment variables)
# The actual Auth Emulator endpoint. Electron uses a development-only same-origin
# proxy automatically; do not point this to the Next.js port.
# Omit protocol prefix (e.g. 127.0.0.1:9099 or localhost:9099)
FIREBASE_AUTH_EMULATOR_HOST=
# These endpoints are public browser development configuration, never credentials.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=
FIREBASE_DATABASE_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_DATABASE_EMULATOR_HOST=
FUNCTIONS_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=
GCLOUD_PROJECT=

# Server-side Firebase Admin (token verification, roles): production uses
# Application Default Credentials (e.g. GOOGLE_APPLICATION_CREDENTIALS pointing
# to a service-account file kept outside the repository). The Auth emulator
# needs none.
GOOGLE_APPLICATION_CREDENTIALS=

# Test credentials for emulator test runners and seed scripts
TEST_USER_PASSWORD=

# Example .env configuration for local emulator development:
# NEXT_PUBLIC_FIREBASE_API_KEY=emulator-only
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=local-test.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=local-test
# NEXT_PUBLIC_FIREBASE_APP_ID=emulator-only
# NEXT_PUBLIC_FIREBASE_GOOGLE_ENABLED=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# GCLOUD_PROJECT=local-test
# TEST_USER_PASSWORD=Test-password-123
