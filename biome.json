{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "plugins": [
    "./.biome/rules/dom/no-document-write.grit",
    "./.biome/rules/nextjs/prefer-layout-props.grit",
    "./.biome/rules/nextjs/prefer-page-props.grit",
    "./.biome/rules/nextjs/prefer-route-context.grit"
  ],
  "files": {
    "ignoreUnknown": false,
    "includes": ["**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      },
      "suspicious": {
        "noReactForwardRef": "error"
      },
      "style": {
        "noJsxLiterals": {
          "level": "error",
          "options": {
            "ignoreProps": true
          }
        }
      },
      "preset": "recommended",
      "correctness": {
        "noComponentHookFactories": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/app/**", "src/components/**", "src/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/router": "Use next/navigation in App Router code.",
                  "next/head": "Use the App Router Metadata API.",
                  "next/document": "Use the App Router root layout.",
                  "next/app": "Use App Router layouts and providers.",
                  "@/i18n/navigation": "Import Link from next/link and navigate through useNavigation from @/hooks/use-navigation; the locale lives in a cookie, so there is no navigation wrapper.",
                  "next/navigation": {
                    "importNames": ["useRouter"],
                    "message": "Navigate through useNavigation from @/hooks/use-navigation; it is the only module that calls useRouter."
                  }
                }
              }
            }
          },
          "correctness": {
            "noNestedComponentDefinitions": "error",
            "noReactPropAssignments": "error"
          }
        }
      }
    },
    {
      "includes": ["src/hooks/use-navigation.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/router": "Use next/navigation in App Router code.",
                  "next/head": "Use the App Router Metadata API.",
                  "next/document": "Use the App Router root layout.",
                  "next/app": "Use App Router layouts and providers.",
                  "@/i18n/navigation": "Import Link from next/link and navigate through useNavigation from @/hooks/use-navigation; the locale lives in a cookie, so there is no navigation wrapper."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx",
        "src/app/**/template.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/router": "Use next/navigation in App Router code.",
                  "next/head": "Use the App Router Metadata API.",
                  "next/document": "Use the App Router root layout.",
                  "next/app": "Use App Router layouts and providers.",
                  "@/i18n/navigation": "Import Link from next/link and navigate through useNavigation from @/hooks/use-navigation; the locale lives in a cookie, so there is no navigation wrapper.",
                  "next/navigation": {
                    "importNames": ["useRouter"],
                    "message": "Navigate through useNavigation from @/hooks/use-navigation; it is the only module that calls useRouter."
                  },
                  "firebase": "Route entrypoints must access Firebase through a data layer.",
                  "firebase-admin": "Route entrypoints must access Firebase through a data layer.",
                  "@/lib/firebase/client": "Use a server data module or a dedicated client component."
                },
                "patterns": [
                  {
                    "group": ["firebase/*", "firebase-admin/*"],
                    "message": "Route entrypoints must access Firebase through a data layer."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/app/**/_hooks/**",
        "src/app/**/_components/**",
        "!src/app/**/*-provider-client.tsx",
        "!src/app/**/*.test.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/router": "Use next/navigation in App Router code.",
                  "next/head": "Use the App Router Metadata API.",
                  "next/document": "Use the App Router root layout.",
                  "next/app": "Use App Router layouts and providers.",
                  "@/i18n/navigation": "Import Link from next/link and navigate through useNavigation from @/hooks/use-navigation; the locale lives in a cookie, so there is no navigation wrapper.",
                  "next/navigation": {
                    "importNames": ["useRouter"],
                    "message": "Navigate through useNavigation from @/hooks/use-navigation; it is the only module that calls useRouter."
                  },
                  "firebase": "Hooks and components depend on a port (dependency inversion); only a *-provider-client.tsx composition root may import the Firebase SDK.",
                  "firebase-admin": "Hooks and components never import the Admin SDK; the page injects a Server Action instead.",
                  "@/lib/firebase/client": "Hooks and components depend on a port (dependency inversion); only a *-provider-client.tsx composition root may import the Firebase client."
                },
                "patterns": [
                  {
                    "group": ["firebase/*"],
                    "message": "Hooks and components depend on a port (dependency inversion); only a *-provider-client.tsx composition root may import the Firebase SDK."
                  },
                  {
                    "group": ["firebase-admin/*"],
                    "message": "Hooks and components never import the Admin SDK; the page injects a Server Action instead."
                  },
                  {
                    "group": [
                      "**/_lib/data",
                      "**/_lib/gateway",
                      "**/_lib/actions"
                    ],
                    "message": "Adapters and Actions are injected (provider or page props); hooks and components use the port or a prop, not _lib/data, _lib/gateway or _lib/actions."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 8
              }
            },
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 40,
                "skipBlankLines": true,
                "skipIifes": false
              }
            },
            "noExcessiveNestedCallbacks": {
              "level": "error",
              "options": {
                "max": 2
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**/*.test.*", "src/**/*.stories.*", "src/**/*.spec.*"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "warn",
              "options": {
                "maxAllowedComplexity": 15
              }
            },
            "noExcessiveLinesPerFunction": {
              "level": "warn",
              "options": {
                "maxLines": 40,
                "skipBlankLines": true,
                "skipIifes": false
              }
            },
            "noExcessiveNestedCallbacks": {
              "level": "warn",
              "options": {
                "max": 2
              }
            }
          },
          "style": {
            "noJsxLiterals": "warn"
          },
          "correctness": {
            "noComponentHookFactories": "warn"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/ui/**",
        "src/components/firebase/**",
        "src/components/ai-elements/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "warn",
              "options": {
                "maxAllowedComplexity": 15
              }
            },
            "noExcessiveLinesPerFunction": {
              "level": "warn",
              "options": {
                "maxLines": 40,
                "skipBlankLines": true,
                "skipIifes": false
              }
            },
            "noExcessiveNestedCallbacks": {
              "level": "warn",
              "options": {
                "max": 2
              }
            }
          },
          "style": {
            "noJsxLiterals": "warn"
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/extensions/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 8
              }
            },
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 40,
                "skipBlankLines": true,
                "skipIifes": false
              }
            },
            "noExcessiveNestedCallbacks": {
              "level": "error",
              "options": {
                "max": 2
              }
            }
          },
          "style": {
            "noJsxLiterals": {
              "level": "error",
              "options": {
                "ignoreProps": true
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/components/ui/extensions/**/*.test.*",
        "src/components/ui/extensions/**/*.stories.*",
        "src/components/ui/extensions/**/*.spec.*"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "warn",
              "options": {
                "maxAllowedComplexity": 15
              }
            },
            "noExcessiveLinesPerFunction": {
              "level": "warn",
              "options": {
                "maxLines": 40,
                "skipBlankLines": true,
                "skipIifes": false
              }
            },
            "noExcessiveNestedCallbacks": {
              "level": "warn",
              "options": {
                "max": 2
              }
            }
          },
          "style": {
            "noJsxLiterals": "warn"
          },
          "correctness": {
            "noComponentHookFactories": "warn"
          }
        }
      }
    },
    {
      "includes": [".agents/skills/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "warn"
          },
          "suspicious": {
            "noAssignInExpressions": "warn",
            "noControlCharactersInRegex": "warn",
            "useIterableCallbackReturn": "warn",
            "noDuplicateObjectKeys": "warn",
            "noDoubleEquals": "warn",
            "noRedeclare": "warn"
          },
          "correctness": {
            "noUnsafeFinally": "warn",
            "useHookAtTopLevel": "warn",
            "noComponentHookFactories": "warn",
            "useYield": "warn"
          },
          "style": {
            "noJsxLiterals": "warn"
          }
        }
      }
    },
    {
      "includes": [".semgrep/**"],
      "linter": {
        "rules": {
          "security": {
            "noGlobalEval": "warn",
            "noDangerouslySetInnerHtml": "warn"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/ui/**",
        "src/components/firebase/**",
        "src/components/ai-elements/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "warn",
            "useFocusableInteractive": "warn",
            "noNoninteractiveTabindex": "warn",
            "useKeyWithClickEvents": "warn",
            "noLabelWithoutControl": "warn"
          },
          "suspicious": {
            "noArrayIndexKey": "warn"
          }
        }
      }
    },
    {
      "includes": ["src/app/**/_components/*-form.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "warn",
              "options": {
                "maxLines": 40,
                "skipBlankLines": true,
                "skipIifes": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/extensions/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "error",
            "useFocusableInteractive": "error",
            "noNoninteractiveTabindex": "error",
            "useKeyWithClickEvents": "error",
            "noLabelWithoutControl": "error"
          },
          "suspicious": {
            "noArrayIndexKey": "error"
          }
        }
      }
    }
  ],
  "yaml": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  }
}
